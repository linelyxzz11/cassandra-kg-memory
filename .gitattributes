# Keep text normalization deterministic across Windows and Linux.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.npy binary
*.npz binary
*.sqlite binary
*.db binary

# Frozen serving evidence is verified by byte-level SHA-256. Keep its original
# line endings instead of applying the text rules above at checkout.
results/serving_100k/resource_matched_v3/resmatch_20260924_v3r2/** -text !eol
results/serving_100k/locomo_workload_100k/traces/** -text !eol
