    "canonical_cat1_4": {
      "name": "cat1_4_1540",
      "split": "",
      "categories": ["1", "2", "3", "4"],
      "expected_query_count": 1540
    }
  },
  "parity": {
    "expected_query_count": 1150,
    "expected_mrr": 0.5462,
    "expected_r10": 0.8070,
    "top_k": 10,
    "score_tolerance": 1e-8,
    "require_score_parity": false
  },
  "bootstrap": {
    "repetitions": 10000,
    "seed": 20260723,
    "cluster_field": "conversation_id",
    "confidence_level": 0.95
  },
  "validation": {
    "require_feature_row_for_every_memory": true,
    "representation_sample_count": 20
